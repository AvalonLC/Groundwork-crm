# Build output — regenerated by npm run build
dist/

# Dependencies — regenerated by npm install
node_modules/

# Wrangler local state — regenerated on first local run
.wrangler/

# Environment secrets — NEVER commit these
.env
.env.production
.dev.vars

# Editor
.vscode/*
!.vscode/launch.json
!.vscode/*.code-snippets
.idea/workspace.xml
.idea/usage.statistics.xml
.idea/shelf

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS
.DS_Store
Thumbs.db

# Finance OS harness — generated by test/wave runs
status.log
test-results.json
test-results-finance/
BLOCKED-*.md
*.tsbuildinfo

# NOTE: scripts/.build-version IS committed so the version counter
# persists across machines and doesn't reset every clone.
