{
  "$schema": "node_modules/wrangler/config-schema.json",

  // ── Project identity ────────────────────────────────────────────────────────
  // "name" is the Cloudflare Pages project name.
  // The project at https://dash.cloudflare.com → Pages is named "groundwork-crm"
  // and serves groundwork-crm.com + www.groundwork-crm.com.
  "name": "groundwork-crm",

  "compatibility_date": "2026-05-03",
  "pages_build_output_dir": "./dist",
  "compatibility_flags": [
    "nodejs_compat"
  ],

  // ── Observability: Cloudflare Workers Logs ────────────────────────────────────
  // Decided 2026-08-22 (Tyler chose this over a third-party tracker like
  // Sentry — see docs/spec/OBSERVABILITY.md). No new secret, no new vendor:
  // this retains and makes searchable every request's invocation log plus
  // all existing console.error/console.warn output (including the three
  // best-effort Finance sync helpers in src/index.tsx) in the Cloudflare
  // dashboard under Workers & Pages → groundwork-crm → Observability.
  // head_sampling_rate omitted -> defaults to 1 (log 100% of requests),
  // fine for this app's traffic volume.
  "observability": {
    "enabled": true
  },

  // ── D1 Database ─────────────────────────────────────────────────────────────
  // Lives in Tyler@avalon-lc.com's Cloudflare account.
  // Run `wrangler d1 list` to verify the UUID if you recreate the project.
  // Local dev: `npm run dev:local` uses --local flag (SQLite on disk, no UUID needed).
  //
  // Finance OS used to live in a separate database (`groundwork`, binding
  // FINANCE_DB) -- merged into this one by migrations/0057_finance_merge.sql
  // (2026-08-09, see docs/RUNBOOK-finance-merge.md for the data-copy step,
  // which a schema migration alone cannot do). migrations/finance/ is kept
  // for historical record of what was applied to the old database; it is no
  // longer an active migrations_dir for anything.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "avalon-sales-hub-production",
      "database_id": "a09eba8e-6c21-4ec3-a257-70a94b6e2aeb"
    }
  ],

  // ── Vectorize: Finance OS classifier stage 3 ──────────────────────────────────
  "vectorize": [
    {
      "binding": "VEC",
      "index_name": "gw-tenant-history"
    }
  ],

  // ── R2 Object Storage ───────────────────────────────────────────────────────
  // MEDIA: client portal project photos and documents (created 2026-07-20).
  // RECEIPTS: Finance OS receipt images + hash dedupe. Local dev uses --local
  // simulation for both.
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "groundwork-crm-media"
    },
    {
      "binding": "RECEIPTS",
      "bucket_name": "gw-receipts"
    }
  ],

  // ── Workers AI: Finance OS classifier stage 4 + OCR + embeddings ─────────────
  "ai": {
    "binding": "AI"
  }
}
