{
  "name": "groundwork-crm",
  "type": "module",
  "scripts": {
    "build": "node scripts/bump-version.js && vite build && cp -r public/js/. dist/js/ && echo '{\"version\":1,\"include\":[\"/*\"],\"exclude\":[\"/js/*\"]}' > dist/_routes.json",
    "dev": "vite",
    "dev:local": "wrangler pages dev dist --local --ip 0.0.0.0 --port 3000",
    "preview": "wrangler pages dev dist --ip 0.0.0.0 --port 3000",
    "deploy": "npm run build && wrangler pages deploy dist --project-name groundwork-crm",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:migrate:local": "wrangler d1 migrations apply avalon-sales-hub-production --local",
    "db:migrate:prod": "wrangler d1 migrations apply avalon-sales-hub-production",
    "test": "vitest run && npm run test:browser-js",
    "test:watch": "vitest",
    "//test:browser-js": "Plain browser scripts under public/js. Separate from vitest because that suite runs in the Cloudflare workers pool, and workerd is pinned to UTC — it ignores TZ, so the date bugs these cover are invisible there. Chained onto `test` so CI still gates on them.",
    "test:browser-js": "TZ=America/New_York node --test tests/gw-date.test.mjs tests/payments-page.test.mjs tests/no-shadow-assets.test.mjs tests/backfill-cli-args.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.finance.json",
    "e2e": "playwright test",
    "e2e:spa": "playwright test --config=playwright.spa.config.ts",
    "preflight": "bash scripts/preflight.sh",
    "db:reset": "rm -rf .wrangler/state && npm run db:migrate:local",
    "validate:finance-config": "node scripts/validate-finance-config.js",
    "test:migrations": "node --test tests/clean-migrations.test.mjs",
    "test:migration-review": "vite build && node --test tests/sales-process-migration-review.integration.test.mjs",
    "test:sales-process-transitions": "vite build && node --test tests/sales-process-transitions.integration.test.mjs",
    "test:sales-process-adoption": "vite build && node --test tests/sales-process-template-adoption.integration.test.mjs",
    "test:sales-process-ui": "node --test tests/sales-process-admin-ui.test.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "hono": "^4.12.23"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.1",
    "@cloudflare/workers-types": "^5.20260804.1",
    "@hono/vite-build": "^1.2.0",
    "@hono/vite-dev-server": "^0.25.2",
    "@playwright/test": "^1.50.0",
    "linkedom": "^0.18.13",
    "typescript": "^5.7.0",
    "vite": "^6.3.5",
    "vitest": "^4.1.0",
    "wrangler": "^4.4.0"
  },
  "engines": {
    "node": ">=20"
  }
}
