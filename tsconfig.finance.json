{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "types": ["@cloudflare/workers-types", "vitest/globals"]
  },
  "include": [
    "src/config/**/*.ts",
    "src/db/**/*.ts",
    "src/engines/**/*.ts",
    "src/api/**/*.ts",
    "src/cron/**/*.ts",
    "src/ai/**/*.ts",
    "src/marketing/**/*.ts",
    "src/ui/**/*.tsx",
    "src/ui/**/*.ts",
    "src/bridge/**/*.ts",
    "src/scheduling/**/*.ts",
    "src/recurring/**/*.ts",
    "src/index.tsx",
    "src/env.ts",
    "src/vite-env.d.ts",
    "src/hono-env.d.ts",
    "scripts/**/*.js"
  ],
  // Test files reference implementation modules from later waves/tasks (e.g.
  // burden.test.ts -> ./burden, written in wave 2) before those exist — a
  // whole-project typecheck gate run during an earlier wave would otherwise
  // never pass. vitest itself still type-checks test files when they run.
  "exclude": ["**/*.test.ts", "**/*.e2e.ts"]
}
